name: Sync to Gemini
on:
  push:
    branches: ["main"]
    paths: ["*.user.js"]

jobs:
  run-sync:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install Puppeteer
        run: npm install puppeteer-extra puppeteer-extra-plugin-stealth puppeteer

      - name: Execute Sync
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          PROXY_SERVER: ${{ secrets.PROXY_SERVER }}
        run: |
          node <<'EOF'
          const puppeteer = require('puppeteer-extra');
          const StealthPlugin = require('puppeteer-extra-plugin-stealth');
          const fs = require('fs');
          puppeteer.use(StealthPlugin());
          (async () => {
            const files = fs.readdirSync('.').filter(f => f.endsWith('.user.js'));
            const browser = await puppeteer.launch({
              headless: "new",
              args: ['--no-sandbox', `--proxy-server=${process.env.PROXY_SERVER || ''}`]
            });
            try {
              const page = await browser.newPage();
              console.log(`Found ${files.length} scripts. Starting sync...`);
              // Your custom sync logic goes here
            } finally {
              await browser.close();
            }
          })();
          EOF